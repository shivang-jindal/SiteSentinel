# SiteSentinel - example environment
# Copy to `.env` and fill in real values. NEVER commit a filled-in .env file.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the API (used in emailed links and CORS allow-listing).
API_URL=http://localhost:4000
# Public URL of the web client.
APP_URL=http://localhost:5173
# Optional extra allowed origins, comma separated.
# APP_URLS=https://app.example.com

# ---- Database --------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite PostgreSQL build
# (local development and tests only). Set it to a real PostgreSQL connection
# string for any shared or production deployment.
# DATABASE_URL=postgresql://user:password@host:5432/sitesentinel
PGLITE_DATA_DIR=.data/pgdata
DATABASE_POOL_MAX=10

# ---- Email -----------------------------------------------------------------
# disabled | smtp | log
#   disabled - no provider; the UI shows "Not connected" and alert emails are
#              recorded with the failure code `not_configured`.
#   smtp     - real delivery through your SMTP provider. A message marked "sent"
#              means the provider accepted it; delivery is never claimed.
#   log      - DEVELOPMENT ONLY. Captures messages to server/.data/outbox and
#              never delivers them. Refused when NODE_ENV=production.
EMAIL_PROVIDER=disabled
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
FROM_EMAIL=alerts@yourdomain.example
# EMAIL_REPLY_TO=

# ---- Security --------------------------------------------------------------
# 32-byte key, 64 hex characters. Required before an alert channel can be
# created (its recipients and webhook secret are encrypted at rest).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=
SESSION_COOKIE_NAME=sitesentinel_session
SESSION_TTL_HOURS=336
# Set to true behind HTTPS (it defaults to true when NODE_ENV=production).
COOKIE_SECURE=false
TRUST_PROXY=false

# ---- Background worker -----------------------------------------------------
# The probe worker runs as its own process: `npm run dev:worker`.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=3
# Set to true only for a single-process deployment. Leave false when the worker
# runs separately - two PGlite processes must not open the same data directory.
WORKER_IN_API=false

# ---- Observability ---------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Optional development seed --------------------------------------------
# Only used by `npm run db:seed`. The seed command refuses to run in production.
# SEED_DEMO_DATA=false
# SEED_EMAIL=demo@sitesentinel.test
# SEED_PASSWORD=sitesentinel-demo-1234