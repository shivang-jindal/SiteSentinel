# Auto detect text files and perform LF normalization
* text=auto

# Package files
*.json text
*.lock text

# Config files
*.yml text
*.yaml text
*.toml text
*.ini text

# Source code
*.ts text
*.tsx text
*.js text
*.jsx text
*.mjs text
*.cjs text
*.css text
*.scss text
*.html text
*.md text

# Shell scripts
*.sh text eol=lf
*.mjs text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Diff settings
*.sql diff=sql
*.css diff=css
*.html diff=html
*.md diff=markdown